# Shared MQTT routing
MQTT_ENABLED=true
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=lora/gateways

# Use credentials provisioned on your broker. Never commit real values.
# MQTT_USERNAME=monitor
# MQTT_PASSWORD=replace-with-a-long-random-secret

# Remote brokers should use TLS on port 8883.
MQTT_TLS=false
# MQTT_CA_CERT=/etc/ssl/certs/mqtt-ca.crt
# MQTT_CLIENT_CERT=/etc/lora-mqtt/monitor.crt
# MQTT_CLIENT_KEY=/etc/lora-mqtt/monitor.key
# MQTT_ALLOW_INSECURE_REMOTE=false
# MQTT_CLIENT_ID=lora-monitor-01

# Gateway publisher settings (set independently on every gateway)
GATEWAY_ID=lora-gateway-01
# GATEWAY_IP=192.168.1.42
GATEWAY_PUBLISH_INTERVAL=60
GATEWAY_STALE_SECONDS=180
MAX_GATEWAYS=100

# HTTP binds to loopback by default. Use a reverse proxy for remote access.
HTTP_HOST=127.0.0.1
HTTP_PORT=5000
# HTTP_TRUSTED_HOSTS=localhost,127.0.0.1,monitor.example.net
# Enable only when every request reaches the app over HTTPS.
HTTP_HSTS=false
